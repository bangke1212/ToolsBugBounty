# Konfigurasi AI untuk Hunter Command Center (server-side saja).
# Salin file ini menjadi .env untuk pengembangan lokal, lalu isi nilainya.
# Di Vercel: isi lewat Project Settings → Environment Variables.
# JANGAN PERNAH commit file .env berisi kunci asli, dan jangan tempelkan
# kunci API di chat, issue, atau screenshot.
#
# Base URL API model (OpenAI-compatible). Default bila kosong:
# https://api.meta.ai/v1
MODEL_API_BASE_URL=https://api.meta.ai/v1
# API key model. WAJIB diisi agar AI Assist aktif. Kosong = AI tidak aktif.
MODEL_API_KEY=
# Model AI yang dipakai. Default bila kosong: muse-spark-1.3
MODEL_API_MODEL=muse-spark-1.3
#
# Live Feed (Vercel KV, opsional). Di Vercel kedua nilai ini ter-inject otomatis
# saat KV store di-attach ke project; untuk dev lokal jalankan `vercel env pull`
# atau salin dari dashboard Storage. Tanpa keduanya, aplikasi jalan mode lokal.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
